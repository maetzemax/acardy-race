; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="acardy-race"
run/main_scene="uid://cuxsom1083lt7"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/image="uid://dk6emryv0sq62"
config/icon="uid://hxx18wkpkp4g"

[autoload]

Nakama="*res://addons/com.heroiclabs.nakama/Nakama.gd"
RacingNakamaClient="*res://api/racing_nakama_client.gd"
LeaderboardService="*res://api/services/leaderboard/leaderboard_service.gd"
UserService="*res://api/services/user/user_service.gd"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/day_and_night_cycle/plugin.cfg")

[file_customization]

folder_colors={
"res://api/": "red",
"res://main_menu/": "purple",
"res://track/": "orange",
"res://ui/": "blue",
"res://vehicle/": "green"
}

[global_group]

CycleController=""
Grass=""
Road=""

